=== B. the doc's key host quotes, re-read verbatim (so the doc and host agree) ===
--- linger file + logind effective config ---
total 8
drwxr-xr-x  2 root root 4096 Sep 13 12:16 .
drwxr-xr-x 13 root root 4096 Aug 23  2024 ..
-rw-r--r--  1 root root    0 Sep 13 12:16 the operator
[Login]
--- user@.service: the delegation + dependency lines ---
After=systemd-user-sessions.service user-runtime-dir@%i.service dbus.service
Requires=user-runtime-dir@%i.service
PAMName=systemd-user
Type=notify
Slice=user-%i.slice
KillMode=mixed
Delegate=pids memory
--- user-runtime-dir@.service: the create/remove contract ---
Description=User Runtime Directory /run/user/%i
StopWhenUnneeded=yes
ExecStart=/lib/systemd/systemd-user-runtime-dir start %i
ExecStop=/lib/systemd/systemd-user-runtime-dir stop %i
RemainAfterExit=yes
--- the user dbus.socket unit (the unit that would own %t/bus) ---
[Unit]
Description=D-Bus User Message Bus Socket

[Socket]
ListenStream=%t/bus
ExecStartPost=-/bin/systemctl --user set-environment DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
