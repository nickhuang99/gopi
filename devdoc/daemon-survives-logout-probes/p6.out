=== B. what my own earlier probe scripts did to those paths (p2 script verbatim) ===
#!/bin/sh
# P2 — the absent user bus: is the PATH missing, or is the socket gone? Read-only.
sec() { echo; echo "=== $1 ==="; }
echo "### probe script: p2-userbus.sh"
UID_N=$(id -u)
sec "stat \$XDG_RUNTIME_DIR/bus"; stat "/run/user/$UID_N/bus"
sec "stat \$XDG_RUNTIME_DIR/systemd/private"; stat "/run/user/$UID_N/systemd/private"
sec "ls -la \$XDG_RUNTIME_DIR/systemd/"; ls -la "/run/user/$UID_N/systemd/"
sec "ls -la \$XDG_RUNTIME_DIR/ (full, alphabetical)"; ls -la "/run/user/$UID_N/"
sec "grep for bus/systemd entries in that listing"; ls -1a "/run/user/$UID_N/" | grep -E 'bus|systemd'
sec "ss -xlp  (HOST-WIDE unix listeners, filtered to this runtime dir)"; ss -xlp 2>/dev/null | grep -F "/run/user/$UID_N"
sec "/proc/net/unix (bound path strings, filtered)"; grep -F "/run/user/$UID_N" /proc/net/unix
sec "which pids own the runtime-dir sockets"; for p in $(ls -d /proc/[0-9]* 2>/dev/null); do
  for f in "$p"/fd/*; do
    t=$(readlink "$f" 2>/dev/null) || continue
    case "$t" in socket*) ;; *) continue;; esac
    # only report processes whose /proc/net/unix inode is one of the two sockets
    :
  done
done
echo "(inode resolution below)"
sec "manager pid + its socket fds"; MANAGER=$(systemctl show -p MainPID --value user@1000.service 2>/dev/null); echo "user@1000 MainPID=$MANAGER"; ls -l "/proc/$MANAGER/fd" 2>&1 | head -40
sec "manager mount namespace view of the paths"; ls -la "/proc/$MANAGER/root/run/user/$UID_N/systemd/" 2>&1; stat "/proc/$MANAGER/root/run/user/$UID_N/bus" 2>&1
sec "namespace identity (self vs manager)"; for ns in mnt net user ipc pid; do printf '%-5s self=%s manager=%s\n' "$ns" "$(readlink /proc/self/ns/$ns)" "$(readlink /proc/$MANAGER/ns/$ns 2>&1)"; done
sec "mountinfo rows for /run/user (self)"; grep -F "/run/user" /proc/self/mountinfo
sec "mountinfo rows for /run/user (manager)"; grep -F "/run/user" "/proc/$MANAGER/mountinfo"
sec "mtimes"; stat -c '%n mtime=%y ctime=%z' "/run/user/$UID_N" "/run/user/$UID_N/systemd" "/run/user/$UID_N/systemd/inaccessible" 2>&1
sec "tmpfiles rules touching /run/user"; grep -rF "/run/user" /usr/lib/tmpfiles.d/ /etc/tmpfiles.d/ 2>/dev/null
sec "systemd user units shipped (dbus.socket / systemd/private)"; ls -la /usr/lib/systemd/user/dbus.socket /usr/lib/systemd/user/systemd-exit.service 2>&1
sec "dbus.socket (systemd user unit) content"; cat /usr/lib/systemd/user/dbus.socket 2>&1
sec "connect() attempts"; command -v python3 >/dev/null 2>&1 && echo "python3: $(command -v python3)" || echo "python3: ABSENT"
python3 - <<'PY' 2>&1
import socket, os, errno
paths = [f"/run/user/{os.getuid()}/bus", f"/run/user/{os.getuid()}/systemd/private"]
for p in paths:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(p)
        print(f"connect({p}) -> OK (manager answered)")
    except OSError as e:
        print(f"connect({p}) -> {errno.errorcode.get(e.errno,'?')}: {e.strerror}")
    finally:
        s.close()
PY
sec "dbus clients"; echo "DBUS_SESSION_BUS_ADDRESS=[${DBUS_SESSION_BUS_ADDRESS-<unset>}]"; dbus-send --session --dest=org.freedesktop.DBus --type=method_call --print-reply / org.freedesktop.DBus.ListNames 2>&1 | head -3; echo "dbus-send exit=$?"
=== C. harness scripts left in the runtime dir (verbatim, first 40 lines each) ===
--- /run/user/1000/mv-run.sh ---
#!/bin/bash
cd /home/user/work/GoPi
echo "== G control: 4-way concurrent, PRIVATE scratch home per process, 3 rounds =="
tot=0; bad=0
for round in 1 2 3; do
  for j in 1 2 3 4; do
    h="/run/user/1000/mv-h$round$j"
    rm -rf "$h"; mkdir -p "$h"
    ( env -u GOPI_AGENT_SESSION -u GOPI_TASK_WRAPPER_ID -u GOPI_TASK_RUN_ID GOPI_TEST_SCRATCH_HOME="$h" \
        go test -count=1 -timeout 5m ./internal/daemoncwd/ > "$h/log" 2>&1 ) &
  done
  wait
  for j in 1 2 3 4; do
    tot=$((tot+1))
    if grep -qE '^--- FAIL' "/run/user/1000/mv-h$round$j/log"; then
      bad=$((bad+1))
      echo "--- FAILED run r$round/p$j ::"
      grep -E '^--- FAIL|_test\.go:[0-9]+:' "/run/user/1000/mv-h$round$j/log" | head -6
    fi
  done
done
echo "G_RESULT private-home+concurrent: $bad/$tot runs failed"
echo "--- one log tail ---"; tail -3 /run/user/1000/mv-h11/log
--- /run/user/1000/mv-run2.sh ---
#!/bin/bash
cd /home/user/work/GoPi
echo "== I: 4-way concurrent, GOPI_TEST_TMPDIR ISOLATED per process, 3 rounds =="
tot=0; bad=0
for round in 1 2 3; do
  for j in 1 2 3 4; do
    h="/run/user/1000/mv-i$round$j"
    rm -rf "$h"; mkdir -p "$h"
    ( env -u GOPI_AGENT_SESSION -u GOPI_TASK_WRAPPER_ID -u GOPI_TASK_RUN_ID GOPI_TEST_TMPDIR="$h" \
        go test -count=1 -timeout 5m ./internal/daemoncwd/ > "$h/log" 2>&1 ) &
  done
  wait
  for j in 1 2 3 4; do
    tot=$((tot+1))
    if grep -qE '^--- FAIL' "/run/user/1000/mv-i$round$j/log"; then
      bad=$((bad+1))
      echo "--- FAILED r$round/p$j ::"
      grep -E '^--- FAIL|_test\.go:[0-9]+:' "/run/user/1000/mv-i$round$j/log" | head -4
    fi
  done
done
echo "I_RESULT isolated-tmpdir+concurrent: $bad/$tot runs failed"
echo "--- sanity: dirs stay distinct ---"
ls -d /run/user/1000/mv-i*/fixture-* 2>/dev/null | head -4
--- /run/user/1000/mv-run3.sh ---
#!/bin/bash
cd /home/user/work/GoPi
mkdir -p /run/user/1000/mv-d1 /run/user/1000/mv-d2
run2() { # $1=label $2=parentA $3=parentB
  echo "== $1: 2-way concurrent =="
  bad=0; tot=0
  for round in 1 2 3 4; do
    a="$2/r$round/a"; b="$3/r$round/b"
    mkdir -p "$a" "$b"
    ( env -u GOPI_AGENT_SESSION -u GOPI_TASK_WRAPPER_ID -u GOPI_TASK_RUN_ID GOPI_TEST_TMPDIR="$a" go test -count=1 -timeout 5m ./internal/daemoncwd/ > "$a/log" 2>&1 ) &
    ( env -u GOPI_AGENT_SESSION -u GOPI_TASK_WRAPPER_ID -u GOPI_TASK_RUN_ID GOPI_TEST_TMPDIR="$b" go test -count=1 -timeout 5m ./internal/daemoncwd/ > "$b/log" 2>&1 ) &
    wait
    for L in "$a" "$b"; do
      tot=$((tot+1))
      if grep -qE '^--- FAIL' "$L/log"; then
        bad=$((bad+1)); echo "  [fail] $(grep -E '^--- FAIL|_test\.go:[0-9]+:' "$L/log" | head -2 | tr '\n' '|' | cut -c1-150)"
      fi
    done
  done
  echo "  RESULT $1: $bad/$tot runs failed"
}
run2 "SHARED-fixture-root" /run/user/1000/mv-s /run/user/1000/mv-s
run2 "DISTINCT-fixture-root" /run/user/1000/mv-d1 /run/user/1000/mv-d2
--- /run/user/1000/mv-run4.sh ---
#!/bin/bash
cd /home/user/work/GoPi
arm() { # $1=label $2=shared|distinct
  echo "== $1: 4-way concurrent, 6 rounds =="
  bad=0; tot=0
  for round in 1 2 3 4 5 6; do
    for j in 1 2 3 4; do
      if [ "$2" = shared ]; then h="/run/user/1000/mv-sh/r$round/p$j";
      else h="/run/user/1000/mv-di$j/r$round/p"; fi
      mkdir -p "$h"
      ( env -u GOPI_AGENT_SESSION -u GOPI_TASK_WRAPPER_ID -u GOPI_TASK_RUN_ID GOPI_TEST_TMPDIR="$h" \
          go test -count=1 -timeout 5m ./internal/daemoncwd/ > "$h/log" 2>&1 ) &
    done
    wait
    for j in 1 2 3 4; do
      if [ "$2" = shared ]; then L="/run/user/1000/mv-sh/r$round/p$j"; else L="/run/user/1000/mv-di$j/r$round/p"; fi
      tot=$((tot+1))
      if grep -qE '^--- FAIL' "$L/log"; then
        bad=$((bad+1)); echo "  [fail] $(grep -E '^--- FAIL|_test\.go:[0-9]+:' "$L/log" | head -2 | tr '\n' '|' | cut -c1-150)"
      fi
    done
  done
  echo "  RESULT $1: $bad/$tot runs failed"
}
arm "SHARED-" shared
arm "DISTINCT-" distinct
